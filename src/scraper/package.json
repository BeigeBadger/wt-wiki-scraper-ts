{
  "name": "scraper",
  "version": "1.0.0",
  "description": "War Thunder Wiki Scraper",
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "build": "tsc",
    "scrape": "tsx index.ts",
    "scrape:verbose": "tsx index.ts --verbose",
    "scrape:skip-db": "tsx index.ts --skip-db",
    "db:populate": "tsx index.ts --db-only",
    "db:init": "tsx index.ts --db-init",
    "test:fixtures": "tsx utils/fixtures.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "mongodb": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^25.2.3",
    "mongodb-memory-server": "^11.0.1",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
