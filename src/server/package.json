{
  "name": "server",
  "version": "1.0.0",
  "description": "WT Wiki GraphQL Server",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@apollo/server": "^4.12.0",
    "@graphql-tools/schema": "^10.0.23",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "graphql": "^16.10.0",
    "mongodb": "^7.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
