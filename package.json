{
  "name": "wt-wiki-monorepo",
  "version": "1.0.0",
  "description": "War Thunder Wiki - Scraper and Web App Monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:app\"",
    "dev:app": "cd src/app && npm run dev",
    "dev:server": "cd src/server && npm run dev",
    "build": "npm run build:app && npm run build:server",
    "build:app": "cd src/app && npm run build",
    "build:server": "cd src/server && npm run build",
    "scrape": "cd src/scraper && npm run scrape",
    "scrape:verbose": "cd src/scraper && npm run scrape:verbose",
    "scrape:skip-db": "cd src/scraper && npm run scrape:skip-db",
    "db:populate": "cd src/scraper && npm run db:populate",
    "db:init": "cd src/scraper && npm run db:init",
    "test": "cd src/scraper && npm run test",
    "test:watch": "cd src/scraper && npm run test:watch",
    "test:ui": "cd src/scraper && npm run test:ui",
    "test:fixtures": "cd src/scraper && npm run test:fixtures",
    "lint": "npm run lint:app && npm run lint:server && npm run lint:scraper",
    "lint:fix": "npm run lint:app:fix && npm run lint:server:fix && npm run lint:scraper:fix",
    "lint:app": "cd src/app && npm run lint",
    "lint:app:fix": "cd src/app && npm run lint:fix",
    "lint:server": "cd src/server && npm run lint",
    "lint:server:fix": "cd src/server && npm run lint:fix",
    "lint:scraper": "cd src/scraper && npm run lint",
    "lint:scraper:fix": "cd src/scraper && npm run lint:fix",
    "format": "npm run format:app && npm run format:server && npm run format:scraper",
    "format:app": "cd src/app && npm run format",
    "format:server": "cd src/server && npm run format",
    "format:scraper": "cd src/scraper && npm run format"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
